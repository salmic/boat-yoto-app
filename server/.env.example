PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
VESSEL_API_KEY=your_vessel_api_key_here
IPAPI_KEY=
# Optional but recommended in production to avoid ipapi.co 429 rate limits
SCAN_RADIUS_NM=25
SHIPS_PER_SCAN=3
TTS_VOICE=en-US-AnaNeural
CACHE_DIR=.cache
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# PUBLIC_BASE_URL is also added to allowed origins automatically
